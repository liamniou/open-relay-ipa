diff --git a/Open UI/Shared/AppGroup.swift b/Open UI/Shared/AppGroup.swift
new file mode 100644
index 0000000..e5842fe
--- /dev/null
+++ b/Open UI/Shared/AppGroup.swift	
@@ -0,0 +1,21 @@
+import Foundation
+import os.log
+
+nonisolated enum AppGroup {
+    static let originalIdentifier = "group.com.openui.openui"
+
+    static func identifier(in bundle: Bundle = .main) -> String {
+        // AltStore adds the signing team suffix and records the granted groups here.
+        guard let groups = bundle.object(forInfoDictionaryKey: "ALTAppGroups") as? [String] else {
+            return originalIdentifier
+        }
+        if let identifier = groups.first(where: {
+            $0 == originalIdentifier || $0.hasPrefix(originalIdentifier + ".")
+        }) {
+            return identifier
+        }
+        Logger(subsystem: "com.openui", category: "AppGroup")
+            .error("AltStore did not provision the Open Relay App Group. Cross-process sharing is unavailable.")
+        return originalIdentifier
+    }
+}
